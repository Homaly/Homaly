# Equipa 4 - Dropouts (Hackathon Aveiro Tech Week 2026, Desafio #3 Altice Labs)
# NAO commitar este ficheiro.

# --- Wi-Fi do hackathon ---
WIFI_SSID=
WIFI_PASSWORD=

# --- MCP Connected Home ---
MCP_URL=
MCP_CLIENT_ID=
MCP_CLIENT_TYPE=
# Ja fornecida pela organizacao; pedir o valor a equipa:
MCP_API_KEY=

# --- Login da equipa (Keycloak / OAuth) ---
# Pedir ao Simao os valores (nao commitar o .env)
KEYCLOAK_USER=
KEYCLOAK_PASSWORD=

# --- IA ---
# falso: sem modelo, a casa usa o resumo do desvio.
# groq (recomendado) ou gemini: os dois tem plano gratis. Cada pessoa cria a sua chave:
#   groq:   https://console.groq.com/keys      (modelo por omissao: openai/gpt-oss-120b)
#   gemini: https://aistudio.google.com/apikey (modelo por omissao: gemini-3.5-flash-lite)
#   openrouter: https://openrouter.ai/keys     (pago; modelo por omissao: anthropic/claude-haiku-5.5)
IA_FORNECEDOR=falso
GROQ_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
# Troca o modelo por omissao do fornecedor (opcional)
IA_MODELO=

# --- Leitura da casa e regras (valores por omissao entre parenteses) ---
# De quanto em quanto tempo ler a casa pelo MCP, em segundos (10)
POLLING_SEGUNDOS=
# Minutos sem comunicar ate as leituras de um dispositivo ficarem de fora; 0 desliga (60)
SENSOR_SILENCIO_MINUTOS=
# US08: minutos de porta aberta ate avisar (5)
PORTA_MINUTOS=
# US12: graus que a sala desce com a porta aberta ate avisar (2)
PORTA_QUEDA_GRAUS=
# US10: abaixo de quantos graus a casa esta fria (16), e durante quantos minutos (120)
FRIO_LIMITE_GRAUS=
FRIO_MINUTOS=
# US11: ao fim de quantas horas acesa a casa pergunta pela luz (5; na demo, ex.: 0.05 = 3 min)
LUZ_HORAS=
# US09: horas sem sinais de vida (3) e buraco nas leituras, em minutos, que recomeça a vigilância (30)
US09_HORAS=
US09_LACUNA_MINUTOS=
# Demo da US09: "a atividade parou" com US09_HORAS baixo (ex.: 0.1); resolver com um sinal, via
# POST /dev/leituras {"dispositivo":"camara","tipo":"motionDetected","valor":"<valor novo de cada vez>"}
# US15: a agua a correr sem parar (contador de agua simulado, injetado em /dev/leituras)
# Minutos seguidos ate avisar (60; na demo, ex.: 2), caudal minimo "a correr" em L/min (0.1),
# abaixo de quantos L/min e um fio de agua (2), e o cano rebentado: L/min (12) durante minutos (5)
AGUA_MINUTOS=
AGUA_LIMITE_LMIN=
FUGA_LMIN=
CANO_LMIN=
CANO_MINUTOS=

# --- Base de dados e desenvolvimento ---
# O ficheiro SQLite (homaly.db, na pasta onde o backend arranca)
DB_PATH=
# Com 1, liga os pedidos /dev (anomalias, eventos e leituras a mao). O docker-compose.yml liga-o.
HOMALY_DEV=
# Com 0, o backend arranca sem --reload (na demo: gravar um ficheiro nao o reinicia) (1)
RECARREGAR=

# --- Contacto externo: SMS pelo textbee (US05) ---
# Sem a chave, as SMS nao saem: ficam no registo e em GET /dev/sms. Ver backend/README.md.
TEXTBEE_API_KEY=
# Opcional: o id do telemovel no textbee, se houver mais de um
TEXTBEE_DEVICE_ID=
# Maximo de SMS por hora, contra abusos (a app nao tem login); 0 tira o limite (10)
SMS_MAXIMO_HORA=
# O inicio do link da SMS; tem de ser alcancavel pelo telemovel do contacto.
# Na demo, o IP do portatil na mesma rede Wi-Fi, ex.: http://192.168.1.20:8000
HOMALY_URL_PUBLICO=

# --- Calendario Google (Definicoes -> Calendario) ---
# Do cliente OAuth "Aplicacao Web" na Google Cloud (pedir a equipa; nunca no git).
# Sem eles, a seccao do calendario diz que nao esta configurada.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Para onde a Google devolve a pessoa; tem de estar registado no cliente OAuth.
# (http://localhost:8000/calendario/google/retorno); no servidor:
# https://homaly.duckdns.org/api/calendario/google/retorno
GOOGLE_REDIRECT_URI=
# Onde esta a PWA, para voltar a ela depois de ligar (http://localhost:5173);
# no servidor: https://homaly.duckdns.org
APP_URL=

# --- Camara (stream RTSP, fora do MCP) ---
CAMERA_RTSP_URL=

# --- Ciclo das regras ---
# Com 1, a app (backend.main) corre o ciclo numa thread: le a casa pelo MCP a cada
# POLLING_SEGUNDOS, corre as regras e publica as anomalias. Desligado por omissao.
CICLO=
# Relogio do ciclo e da API (um so por processo; na app e no backend.ciclo --ao-vivo)
# Relogio acelerado para a demo. Sem RELOGIO_INICIO, e a hora real.
# Ex.: RELOGIO_INICIO=2026-11-19T06:30:00 e RELOGIO_FATOR=60 (1 s real = 1 min simulado).
# US09 (manha sem atividade): comecar antes do primeiro sinal habitual (07:15 nos dias uteis),
# senao a casa nao sabe o que se passou de manha e nao avisa.
# Fator x (POLLING_SEGUNDOS + duracao de uma volta) abaixo de US09_LACUNA_MINUTOS, senao cada
# volta e um buraco e a US09 nunca dispara. COMANDO_SEGUNDOS (60 s reais) pressupoe um polling bem abaixo disso.
RELOGIO_INICIO=
RELOGIO_FATOR=

# --- Frontend ---
# As variaveis do frontend ficam em frontend/.env (ver frontend/.env.example).

# --- Docker ---
# Porta do backend na maquina, se a 8000 estiver ocupada (por omissao 8000)
BACKEND_PORT=
