<mxfile host="app.diagrams.net" agent="Homaly" version="24.0.0"><diagram id="contexto" name="1. Contexto"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="2400" pageHeight="1400" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="contexto-v1" value="Homaly: diagrama de contexto do sistema (C4, nível 1)" style="text;html=1;align=left;verticalAlign=top;fontSize=20;fontStyle=1;fontColor=#1B1F24;" vertex="1" parent="1"><mxGeometry x="20" y="-60" width="1400" height="34" as="geometry"/></mxCell><mxCell id="contexto-v2" value="Base: DECISIONS.md, USER_STORIES.md, docs/frontend-design.md, docs/mcp-dispositivos.md e os diagramas de sequência desta pasta. Versão de 2026-11-17." style="text;html=1;align=left;verticalAlign=top;fontSize=12;fontColor=#5A626E;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="20" y="-24" width="1400" height="40" as="geometry"/></mxCell><mxCell id="contexto-v3" value="&lt;b&gt;&lt;font style=&quot;font-size: 14px&quot;&gt;Responsável da casa&lt;/font&gt;&lt;/b&gt;&lt;div&gt;[Pessoa]&lt;/div&gt;&lt;br&gt;&lt;div&gt;&lt;font color=&quot;#CCCCCC&quot;&gt;Única pessoa com a aplicação. Conta à casa o dia a dia, responde às anomalias e autoriza ações. Pode não viver lá.&lt;/font&gt;&lt;/div&gt;" style="html=1;fontSize=11;dashed=0;whiteSpace=wrap;fillColor=#083F75;strokeColor=#06315C;fontColor=#ffffff;shape=mxgraph.c4.person2;align=center;metaEdit=1;spacing=8;points=[[0.5,0,0],[1,0.5,0],[1,0.75,0],[0.75,1,0],[0.5,1,0],[0.25,1,0],[0,0.75,0],[0,0.5,0]];" vertex="1" parent="1"><mxGeometry x="540" y="40" width="200" height="180" as="geometry"/></mxCell><mxCell id="contexto-v4" value="&lt;b&gt;&lt;font style=&quot;font-size: 14px&quot;&gt;Contacto externo&lt;/font&gt;&lt;/b&gt;&lt;div&gt;[Pessoa]&lt;/div&gt;&lt;br&gt;&lt;div&gt;&lt;font color=&quot;#CCCCCC&quot;&gt;Vizinho ou familiar escolhido pelo responsável. Recebe por SMS os alertas de segurança e de bem-estar.&lt;/font&gt;&lt;/div&gt;" style="html=1;fontSize=11;dashed=0;whiteSpace=wrap;fillColor=#083F75;strokeColor=#06315C;fontColor=#ffffff;shape=mxgraph.c4.person2;align=center;metaEdit=1;spacing=8;points=[[0.5,0,0],[1,0.5,0],[1,0.75,0],[0.75,1,0],[0.5,1,0],[0.25,1,0],[0,0.75,0],[0,0.5,0]];" vertex="1" parent="1"><mxGeometry x="1100" y="40" width="200" height="180" as="geometry"/></mxCell><mxCell id="contexto-v5" value="&lt;b&gt;&lt;font style=&quot;font-size: 14px&quot;&gt;Homaly&lt;/font&gt;&lt;/b&gt;&lt;div&gt;[Sistema de software]&lt;/div&gt;&lt;br&gt;&lt;div&gt;&lt;font color=&quot;#E1ECF7&quot;&gt;A casa que repara: aprende o que é habitual, deteta anomalias, pergunta antes de alarmar e só age com autorização.&lt;/font&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;labelBackgroundColor=none;align=center;arcSize=10;fontSize=11;fontColor=#ffffff;spacing=8;fillColor=#1061B0;strokeColor=#0D5091;" vertex="1" parent="1"><mxGeometry x="510" y="380" width="260" height="140" as="geometry"/></mxCell><mxCell id="contexto-v6" value="&lt;b&gt;&lt;font style=&quot;font-size: 14px&quot;&gt;Modelo de IA&lt;/font&gt;&lt;/b&gt;&lt;div&gt;[Sistema externo, por decidir]&lt;/div&gt;&lt;br&gt;&lt;div&gt;&lt;font color=&quot;#ECEAF0&quot;&gt;Avalia o contexto, escreve as explicações, interpreta mensagens e descreve imagens.&lt;/font&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;labelBackgroundColor=none;align=center;arcSize=10;fontSize=11;fontColor=#ffffff;spacing=8;fillColor=#8C8496;strokeColor=#736782;" vertex="1" parent="1"><mxGeometry x="40" y="380" width="260" height="140" as="geometry"/></mxCell><mxCell id="contexto-v7" value="&lt;b&gt;&lt;font style=&quot;font-size: 14px&quot;&gt;textbee&lt;/font&gt;&lt;/b&gt;&lt;div&gt;[Sistema externo]&lt;/div&gt;&lt;br&gt;&lt;div&gt;&lt;font color=&quot;#ECEAF0&quot;&gt;Gateway de SMS: API na cloud e app Android no telemóvel de um colega da equipa.&lt;/font&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;labelBackgroundColor=none;align=center;arcSize=10;fontSize=11;fontColor=#ffffff;spacing=8;fillColor=#8C8496;strokeColor=#736782;" vertex="1" parent="1"><mxGeometry x="1070" y="380" width="260" height="140" as="geometry"/></mxCell><mxCell id="contexto-v8" value="&lt;b&gt;&lt;font style=&quot;font-size: 14px&quot;&gt;Keycloak da Altice&lt;/font&gt;&lt;/b&gt;&lt;div&gt;[Sistema externo]&lt;/div&gt;&lt;br&gt;&lt;div&gt;&lt;font color=&quot;#ECEAF0&quot;&gt;Autenticação OAuth da conta da equipa.&lt;/font&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;labelBackgroundColor=none;align=center;arcSize=10;fontSize=11;fontColor=#ffffff;spacing=8;fillColor=#8C8496;strokeColor=#736782;" vertex="1" parent="1"><mxGeometry x="40" y="720" width="260" height="140" as="geometry"/></mxCell><mxCell id="contexto-v9" value="&lt;b&gt;&lt;font style=&quot;font-size: 14px&quot;&gt;Servidor MCP da Altice&lt;/font&gt;&lt;/b&gt;&lt;div&gt;[Sistema externo]&lt;/div&gt;&lt;br&gt;&lt;div&gt;&lt;font color=&quot;#ECEAF0&quot;&gt;Smarthome MCP Server, obrigatório no desafio. 18 ferramentas para ler e comandar a casa; não envia eventos.&lt;/font&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;labelBackgroundColor=none;align=center;arcSize=10;fontSize=11;fontColor=#ffffff;spacing=8;fillColor=#8C8496;strokeColor=#736782;" vertex="1" parent="1"><mxGeometry x="510" y="720" width="260" height="140" as="geometry"/></mxCell><mxCell id="contexto-v10" value="&lt;b&gt;&lt;font style=&quot;font-size: 14px&quot;&gt;Dispositivos da casa&lt;/font&gt;&lt;/b&gt;&lt;div&gt;[Sistema externo]&lt;/div&gt;&lt;br&gt;&lt;div&gt;&lt;font color=&quot;#ECEAF0&quot;&gt;Sensor de porta, sensor de temperatura, lâmpada, câmara (entrada de veículos), tomada e gateway.&lt;/font&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;labelBackgroundColor=none;align=center;arcSize=10;fontSize=11;fontColor=#ffffff;spacing=8;fillColor=#8C8496;strokeColor=#736782;" vertex="1" parent="1"><mxGeometry x="1070" y="720" width="260" height="140" as="geometry"/></mxCell><mxCell id="contexto-e11" value="&lt;b&gt;Conta o dia a dia, responde e autoriza ações&lt;/b&gt;&lt;div&gt;[HTTPS, WebSocket]&lt;/div&gt;" style="endArrow=blockThin;html=1;fontSize=10;fontColor=#404040;strokeWidth=1;endFill=1;strokeColor=#828282;endSize=14;startSize=14;jumpStyle=arc;jumpSize=16;rounded=0;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="contexto-v3" target="contexto-v5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="contexto-e12" value="&lt;b&gt;Pede avaliações e textos&lt;/b&gt;&lt;div&gt;[HTTPS]&lt;/div&gt;" style="endArrow=blockThin;html=1;fontSize=10;fontColor=#404040;strokeWidth=1;endFill=1;strokeColor=#828282;endSize=14;startSize=14;jumpStyle=arc;jumpSize=16;rounded=0;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="contexto-v5" target="contexto-v6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="contexto-e13" value="&lt;b&gt;Pede o envio de SMS&lt;/b&gt;&lt;div&gt;[HTTPS]&lt;/div&gt;" style="endArrow=blockThin;html=1;fontSize=10;fontColor=#404040;strokeWidth=1;endFill=1;strokeColor=#828282;endSize=14;startSize=14;jumpStyle=arc;jumpSize=16;rounded=0;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="contexto-v5" target="contexto-v7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="contexto-e14" value="&lt;b&gt;Envia a SMS com o link&lt;/b&gt;&lt;div&gt;[SMS]&lt;/div&gt;" style="endArrow=blockThin;html=1;fontSize=10;fontColor=#404040;strokeWidth=1;endFill=1;strokeColor=#828282;endSize=14;startSize=14;jumpStyle=arc;jumpSize=16;rounded=0;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="contexto-v7" target="contexto-v4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="contexto-e15" value="&lt;b&gt;Abre a página do alerta (só leitura)&lt;/b&gt;&lt;div&gt;[HTTPS]&lt;/div&gt;" style="endArrow=blockThin;html=1;fontSize=10;fontColor=#404040;strokeWidth=1;endFill=1;strokeColor=#828282;endSize=14;startSize=14;jumpStyle=arc;jumpSize=16;rounded=0;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="contexto-v4" target="contexto-v5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="contexto-e16" value="&lt;b&gt;Obtém o token&lt;/b&gt;&lt;div&gt;[OAuth]&lt;/div&gt;" style="endArrow=blockThin;html=1;fontSize=10;fontColor=#404040;strokeWidth=1;endFill=1;strokeColor=#828282;endSize=14;startSize=14;jumpStyle=arc;jumpSize=16;rounded=0;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="contexto-v5" target="contexto-v8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="contexto-e17" value="&lt;b&gt;Lê o estado e executa ações&lt;/b&gt;&lt;div&gt;[MCP sobre HTTP]&lt;/div&gt;" style="endArrow=blockThin;html=1;fontSize=10;fontColor=#404040;strokeWidth=1;endFill=1;strokeColor=#828282;endSize=14;startSize=14;jumpStyle=arc;jumpSize=16;rounded=0;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="contexto-v5" target="contexto-v9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="contexto-e18" value="&lt;b&gt;Lê e comanda&lt;/b&gt;&lt;div&gt;[plataforma Altice]&lt;/div&gt;" style="endArrow=blockThin;html=1;fontSize=10;fontColor=#404040;strokeWidth=1;endFill=1;strokeColor=#828282;endSize=14;startSize=14;jumpStyle=arc;jumpSize=16;rounded=0;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="contexto-v9" target="contexto-v10"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="contexto-e19" value="&lt;b&gt;Capta imagens da câmara&lt;/b&gt;&lt;div&gt;[RTSP]&lt;/div&gt;" style="endArrow=blockThin;html=1;fontSize=10;fontColor=#404040;strokeWidth=1;endFill=1;strokeColor=#828282;endSize=14;startSize=14;jumpStyle=arc;jumpSize=16;rounded=0;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="contexto-v5" target="contexto-v10"><mxGeometry x="0.3" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="contexto-v20" value="Legenda" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="40" y="920" width="100" height="30" as="geometry"/></mxCell><mxCell id="contexto-v21" value="&lt;b&gt;Pessoa&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;labelBackgroundColor=none;align=center;arcSize=10;fontSize=11;fontColor=#ffffff;spacing=8;fillColor=#083F75;strokeColor=#06315C;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="956" width="150" height="40" as="geometry"/></mxCell><mxCell id="contexto-v22" value="&lt;b&gt;Sistema de software&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;labelBackgroundColor=none;align=center;arcSize=10;fontSize=11;fontColor=#ffffff;spacing=8;fillColor=#1061B0;strokeColor=#0D5091;fontSize=11;" vertex="1" parent="1"><mxGeometry x="205" y="956" width="150" height="40" as="geometry"/></mxCell><mxCell id="contexto-v23" value="&lt;b&gt;Sistema externo&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;labelBackgroundColor=none;align=center;arcSize=10;fontSize=11;fontColor=#ffffff;spacing=8;fillColor=#8C8496;strokeColor=#736782;fontSize=11;" vertex="1" parent="1"><mxGeometry x="370" y="956" width="150" height="40" as="geometry"/></mxCell><mxCell id="contexto-v24" value="&lt;b&gt;Fronteira&lt;/b&gt;" style="rounded=1;fontSize=11;whiteSpace=wrap;html=1;dashed=1;arcSize=20;fillColor=none;strokeColor=#666666;fontColor=#333333;labelBackgroundColor=none;align=left;spacing=10;dashPattern=8 4;connectable=0;allowArrows=0;pointerEvents=0;absoluteArcSize=1;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="535" y="956" width="150" height="40" as="geometry"/></mxCell><mxCell id="contexto-v25" value="" style="text;html=1;" vertex="1" parent="1"><mxGeometry x="700" y="966" width="1" height="20" as="geometry"/></mxCell><mxCell id="contexto-v26" value="" style="text;html=1;" vertex="1" parent="1"><mxGeometry x="820" y="966" width="1" height="20" as="geometry"/></mxCell><mxCell id="contexto-e27" value="&lt;b&gt;Relação&lt;/b&gt;" style="endArrow=blockThin;html=1;fontSize=10;fontColor=#404040;strokeWidth=1;endFill=1;strokeColor=#828282;endSize=14;startSize=14;jumpStyle=arc;jumpSize=16;rounded=0;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="contexto-v25" target="contexto-v26"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="contexto-v28" value="A seta aponta para quem recebe o pedido. «Por decidir», «proposto» e «por definir» marcam o que a equipa ainda não fechou." style="text;html=1;align=left;verticalAlign=top;fontSize=12;fontColor=#5A626E;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="840" y="956" width="380" height="44" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="contentores" name="2. Contentores"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="2400" pageHeight="1400" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="contentores-v1" value="Homaly: diagrama de contentores (C4, nível 2)" style="text;html=1;align=left;verticalAlign=top;fontSize=20;fontStyle=1;fontColor=#1B1F24;" vertex="1" parent="1"><mxGeometry x="20" y="-60" width="1400" height="34" as="geometry"/></mxCell><mxCell id="contentores-v2" value="Base: DECISIONS.md, USER_STORIES.md, docs/frontend-design.md, docs/mcp-dispositivos.md e os diagramas de sequência desta pasta. Versão de 2026-11-17." style="text;html=1;align=left;verticalAlign=top;fontSize=12;fontColor=#5A626E;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="20" y="-24" width="1400" height="40" as="geometry"/></mxCell><mxCell id="contentores-v3" value="&lt;b&gt;&lt;font style=&quot;font-size: 14px&quot;&gt;Responsável da casa&lt;/font&gt;&lt;/b&gt;&lt;div&gt;[Pessoa]&lt;/div&gt;&lt;br&gt;&lt;div&gt;&lt;font color=&quot;#CCCCCC&quot;&gt;Única pessoa com a aplicação.&lt;/font&gt;&lt;/div&gt;" style="html=1;fontSize=11;dashed=0;whiteSpace=wrap;fillColor=#083F75;strokeColor=#06315C;fontColor=#ffffff;shape=mxgraph.c4.person2;align=center;metaEdit=1;spacing=8;points=[[0.5,0,0],[1,0.5,0],[1,0.75,0],[0.75,1,0],[0.5,1,0],[0.25,1,0],[0,0.75,0],[0,0.5,0]];" vertex="1" parent="1"><mxGeometry x="270" y="40" width="200" height="180" as="geometry"/></mxCell><mxCell id="contentores-v4" value="&lt;b&gt;&lt;font style=&quot;font-size: 14px&quot;&gt;Contacto externo&lt;/font&gt;&lt;/b&gt;&lt;div&gt;[Pessoa]&lt;/div&gt;&lt;br&gt;&lt;div&gt;&lt;font color=&quot;#CCCCCC&quot;&gt;Recebe por SMS os alertas de segurança e de bem-estar.&lt;/font&gt;&lt;/div&gt;" style="html=1;fontSize=11;dashed=0;whiteSpace=wrap;fillColor=#083F75;strokeColor=#06315C;fontColor=#ffffff;shape=mxgraph.c4.person2;align=center;metaEdit=1;spacing=8;points=[[0.5,0,0],[1,0.5,0],[1,0.75,0],[0.75,1,0],[0.5,1,0],[0.25,1,0],[0,0.75,0],[0,0.5,0]];" vertex="1" parent="1"><mxGeometry x="1070" y="40" width="200" height="180" as="geometry"/></mxCell><mxCell id="contentores-v5" value="&lt;b&gt;&lt;font style=&quot;font-size: 14px&quot;&gt;Homaly&lt;/font&gt;&lt;/b&gt;&lt;div&gt;[Sistema de software]&lt;/div&gt;" style="rounded=1;fontSize=11;whiteSpace=wrap;html=1;dashed=1;arcSize=20;fillColor=none;strokeColor=#666666;fontColor=#333333;labelBackgroundColor=none;align=left;spacing=10;dashPattern=8 4;connectable=0;allowArrows=0;pointerEvents=0;absoluteArcSize=1;verticalAlign=bottom;" vertex="1" parent="1"><mxGeometry x="220" y="300" width="1120" height="520" as="geometry"/></mxCell><mxCell id="contentores-v6" value="&lt;b&gt;&lt;font style=&quot;font-size: 14px&quot;&gt;PWA Homaly&lt;/font&gt;&lt;/b&gt;&lt;div&gt;[Contentor: React 19, Vite, TypeScript]&lt;/div&gt;&lt;br&gt;&lt;div&gt;&lt;font color=&quot;#EAF6FC&quot;&gt;Aplicação para telemóvel: Início, Conversa, Histórico, Definições e detalhe da anomalia. Recebe anomalias e eventos em tempo real.&lt;/font&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;labelBackgroundColor=none;align=center;arcSize=10;fontSize=11;fontColor=#ffffff;spacing=8;fillColor=#23A2D9;strokeColor=#0E7DAD;" vertex="1" parent="1"><mxGeometry x="240" y="340" width="260" height="150" as="geometry"/></mxCell><mxCell id="contentores-v7" value="&lt;b&gt;&lt;font style=&quot;font-size: 14px&quot;&gt;Página do alerta&lt;/font&gt;&lt;/b&gt;&lt;div&gt;[Contentor: página web, por definir]&lt;/div&gt;&lt;br&gt;&lt;div&gt;&lt;font color=&quot;#EAF6FC&quot;&gt;Página só de leitura aberta a partir da SMS: o alerta e o estado atual da casa.&lt;/font&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;labelBackgroundColor=none;align=center;arcSize=10;fontSize=11;fontColor=#ffffff;spacing=8;fillColor=#23A2D9;strokeColor=#0E7DAD;" vertex="1" parent="1"><mxGeometry x="1040" y="340" width="260" height="150" as="geometry"/></mxCell><mxCell id="contentores-v8" value="&lt;b&gt;&lt;font style=&quot;font-size: 14px&quot;&gt;Base de dados&lt;/font&gt;&lt;/b&gt;&lt;div&gt;[Contentor: SQLite, proposto]&lt;/div&gt;&lt;br&gt;&lt;div&gt;&lt;font color=&quot;#EAF6FC&quot;&gt;Histórico, eventos, anomalias, conversa, rotinas, silêncios, veículos conhecidos e definições.&lt;/font&gt;&lt;/div&gt;" style="shape=cylinder3;size=15;whiteSpace=wrap;html=1;boundedLbl=1;rounded=0;labelBackgroundColor=none;fillColor=#23A2D9;strokeColor=#0E7DAD;fontSize=11;fontColor=#ffffff;align=center;spacing=8;" vertex="1" parent="1"><mxGeometry x="240" y="600" width="260" height="150" as="geometry"/></mxCell><mxCell id="contentores-v9" value="&lt;b&gt;&lt;font style=&quot;font-size: 14px&quot;&gt;Backend Homaly&lt;/font&gt;&lt;/b&gt;&lt;div&gt;[Contentor: Python 3.12, FastAPI, uvicorn]&lt;/div&gt;&lt;br&gt;&lt;div&gt;&lt;font color=&quot;#EAF6FC&quot;&gt;Um só serviço: API e WebSocket, leitura dos sensores, regras de anomalia, agente de IA e avisos.&lt;/font&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;labelBackgroundColor=none;align=center;arcSize=10;fontSize=11;fontColor=#ffffff;spacing=8;fillColor=#23A2D9;strokeColor=#0E7DAD;" vertex="1" parent="1"><mxGeometry x="650" y="600" width="260" height="150" as="geometry"/></mxCell><mxCell id="contentores-v10" value="&lt;b&gt;&lt;font style=&quot;font-size: 14px&quot;&gt;textbee&lt;/font&gt;&lt;/b&gt;&lt;div&gt;[Sistema externo]&lt;/div&gt;&lt;br&gt;&lt;div&gt;&lt;font color=&quot;#ECEAF0&quot;&gt;Gateway de SMS: API na cloud e app Android no telemóvel de um colega.&lt;/font&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;labelBackgroundColor=none;align=center;arcSize=10;fontSize=11;fontColor=#ffffff;spacing=8;fillColor=#8C8496;strokeColor=#736782;" vertex="1" parent="1"><mxGeometry x="1460" y="605" width="260" height="140" as="geometry"/></mxCell><mxCell id="contentores-v11" value="&lt;b&gt;&lt;font style=&quot;font-size: 14px&quot;&gt;Modelo de IA&lt;/font&gt;&lt;/b&gt;&lt;div&gt;[Sistema externo, por decidir]&lt;/div&gt;&lt;br&gt;&lt;div&gt;&lt;font color=&quot;#ECEAF0&quot;&gt;Avaliações, explicações, interpretação de mensagens e descrição de imagens.&lt;/font&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;labelBackgroundColor=none;align=center;arcSize=10;fontSize=11;fontColor=#ffffff;spacing=8;fillColor=#8C8496;strokeColor=#736782;" vertex="1" parent="1"><mxGeometry x="40" y="900" width="260" height="140" as="geometry"/></mxCell><mxCell id="contentores-v12" value="&lt;b&gt;&lt;font style=&quot;font-size: 14px&quot;&gt;Keycloak da Altice&lt;/font&gt;&lt;/b&gt;&lt;div&gt;[Sistema externo]&lt;/div&gt;&lt;br&gt;&lt;div&gt;&lt;font color=&quot;#ECEAF0&quot;&gt;Autenticação OAuth da conta da equipa.&lt;/font&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;labelBackgroundColor=none;align=center;arcSize=10;fontSize=11;fontColor=#ffffff;spacing=8;fillColor=#8C8496;strokeColor=#736782;" vertex="1" parent="1"><mxGeometry x="360" y="900" width="260" height="140" as="geometry"/></mxCell><mxCell id="contentores-v13" value="&lt;b&gt;&lt;font style=&quot;font-size: 14px&quot;&gt;Servidor MCP da Altice&lt;/font&gt;&lt;/b&gt;&lt;div&gt;[Sistema externo]&lt;/div&gt;&lt;br&gt;&lt;div&gt;&lt;font color=&quot;#ECEAF0&quot;&gt;18 ferramentas para ler e comandar a casa; sem eventos.&lt;/font&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;labelBackgroundColor=none;align=center;arcSize=10;fontSize=11;fontColor=#ffffff;spacing=8;fillColor=#8C8496;strokeColor=#736782;" vertex="1" parent="1"><mxGeometry x="680" y="900" width="260" height="140" as="geometry"/></mxCell><mxCell id="contentores-v14" value="&lt;b&gt;&lt;font style=&quot;font-size: 14px&quot;&gt;Dispositivos da casa&lt;/font&gt;&lt;/b&gt;&lt;div&gt;[Sistema externo]&lt;/div&gt;&lt;br&gt;&lt;div&gt;&lt;font color=&quot;#ECEAF0&quot;&gt;Porta, temperatura, lâmpada, câmara, tomada e gateway.&lt;/font&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;labelBackgroundColor=none;align=center;arcSize=10;fontSize=11;fontColor=#ffffff;spacing=8;fillColor=#8C8496;strokeColor=#736782;" vertex="1" parent="1"><mxGeometry x="1100" y="900" width="260" height="140" as="geometry"/></mxCell><mxCell id="contentores-e15" value="&lt;b&gt;Usa no telemóvel&lt;/b&gt;&lt;div&gt;[HTTPS]&lt;/div&gt;" style="endArrow=blockThin;html=1;fontSize=10;fontColor=#404040;strokeWidth=1;endFill=1;strokeColor=#828282;endSize=14;startSize=14;jumpStyle=arc;jumpSize=16;rounded=0;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="contentores-v3" target="contentores-v6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="contentores-e16" value="&lt;b&gt;Pedidos da API e tempo real&lt;/b&gt;&lt;div&gt;[JSON/HTTPS, WebSocket /ws]&lt;/div&gt;" style="endArrow=blockThin;html=1;fontSize=10;fontColor=#404040;strokeWidth=1;endFill=1;strokeColor=#828282;endSize=14;startSize=14;jumpStyle=arc;jumpSize=16;rounded=0;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="contentores-v6" target="contentores-v9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="contentores-e17" value="&lt;b&gt;Abre o link da SMS&lt;/b&gt;&lt;div&gt;[HTTPS]&lt;/div&gt;" style="endArrow=blockThin;html=1;fontSize=10;fontColor=#404040;strokeWidth=1;endFill=1;strokeColor=#828282;endSize=14;startSize=14;jumpStyle=arc;jumpSize=16;rounded=0;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="contentores-v4" target="contentores-v7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="contentores-e18" value="&lt;b&gt;Pede o alerta e o estado atual&lt;/b&gt;&lt;div&gt;[JSON/HTTPS, por definir]&lt;/div&gt;" style="endArrow=blockThin;html=1;fontSize=10;fontColor=#404040;strokeWidth=1;endFill=1;strokeColor=#828282;endSize=14;startSize=14;jumpStyle=arc;jumpSize=16;rounded=0;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="contentores-v7" target="contentores-v9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="contentores-e19" value="&lt;b&gt;Lê e escreve&lt;/b&gt;&lt;div&gt;[SQL]&lt;/div&gt;" style="endArrow=blockThin;html=1;fontSize=10;fontColor=#404040;strokeWidth=1;endFill=1;strokeColor=#828282;endSize=14;startSize=14;jumpStyle=arc;jumpSize=16;rounded=0;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="contentores-v9" target="contentores-v8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="contentores-e20" value="&lt;b&gt;Pede o envio de SMS&lt;/b&gt;&lt;div&gt;[HTTPS]&lt;/div&gt;" style="endArrow=blockThin;html=1;fontSize=10;fontColor=#404040;strokeWidth=1;endFill=1;strokeColor=#828282;endSize=14;startSize=14;jumpStyle=arc;jumpSize=16;rounded=0;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="contentores-v9" target="contentores-v10"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="contentores-e21" value="&lt;b&gt;Envia a SMS com o link&lt;/b&gt;&lt;div&gt;[SMS]&lt;/div&gt;" style="endArrow=blockThin;html=1;fontSize=10;fontColor=#404040;strokeWidth=1;endFill=1;strokeColor=#828282;endSize=14;startSize=14;jumpStyle=arc;jumpSize=16;rounded=0;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="contentores-v10" target="contentores-v4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="contentores-e22" value="&lt;b&gt;Avaliações e textos&lt;/b&gt;&lt;div&gt;[HTTPS]&lt;/div&gt;" style="endArrow=blockThin;html=1;fontSize=10;fontColor=#404040;strokeWidth=1;endFill=1;strokeColor=#828282;endSize=14;startSize=14;jumpStyle=arc;jumpSize=16;rounded=0;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="contentores-v9" target="contentores-v11"><mxGeometry x="0.35" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="contentores-e23" value="&lt;b&gt;Obtém o token&lt;/b&gt;&lt;div&gt;[OAuth, grant password]&lt;/div&gt;" style="endArrow=blockThin;html=1;fontSize=10;fontColor=#404040;strokeWidth=1;endFill=1;strokeColor=#828282;endSize=14;startSize=14;jumpStyle=arc;jumpSize=16;rounded=0;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="contentores-v9" target="contentores-v12"><mxGeometry x="0.35" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="contentores-e24" value="&lt;b&gt;Polling e ações&lt;/b&gt;&lt;div&gt;[MCP sobre HTTP]&lt;/div&gt;" style="endArrow=blockThin;html=1;fontSize=10;fontColor=#404040;strokeWidth=1;endFill=1;strokeColor=#828282;endSize=14;startSize=14;jumpStyle=arc;jumpSize=16;rounded=0;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="contentores-v9" target="contentores-v13"><mxGeometry x="0.35" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="contentores-e25" value="&lt;b&gt;Capta imagens da câmara&lt;/b&gt;&lt;div&gt;[RTSP]&lt;/div&gt;" style="endArrow=blockThin;html=1;fontSize=10;fontColor=#404040;strokeWidth=1;endFill=1;strokeColor=#828282;endSize=14;startSize=14;jumpStyle=arc;jumpSize=16;rounded=0;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="contentores-v9" target="contentores-v14"><mxGeometry x="0.35" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="contentores-e26" value="&lt;b&gt;Lê e comanda&lt;/b&gt;&lt;div&gt;[plataforma Altice]&lt;/div&gt;" style="endArrow=blockThin;html=1;fontSize=10;fontColor=#404040;strokeWidth=1;endFill=1;strokeColor=#828282;endSize=14;startSize=14;jumpStyle=arc;jumpSize=16;rounded=0;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="contentores-v13" target="contentores-v14"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="contentores-v27" value="Legenda" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="40" y="1110" width="100" height="30" as="geometry"/></mxCell><mxCell id="contentores-v28" value="&lt;b&gt;Pessoa&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;labelBackgroundColor=none;align=center;arcSize=10;fontSize=11;fontColor=#ffffff;spacing=8;fillColor=#083F75;strokeColor=#06315C;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="1146" width="150" height="40" as="geometry"/></mxCell><mxCell id="contentores-v29" value="&lt;b&gt;Contentor&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;labelBackgroundColor=none;align=center;arcSize=10;fontSize=11;fontColor=#ffffff;spacing=8;fillColor=#23A2D9;strokeColor=#0E7DAD;fontSize=11;" vertex="1" parent="1"><mxGeometry x="205" y="1146" width="150" height="40" as="geometry"/></mxCell><mxCell id="contentores-v30" value="&lt;b&gt;Base de dados&lt;/b&gt;" style="shape=cylinder3;size=15;whiteSpace=wrap;html=1;boundedLbl=1;rounded=0;labelBackgroundColor=none;fillColor=#23A2D9;strokeColor=#0E7DAD;fontSize=11;fontColor=#ffffff;align=center;spacing=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="370" y="1146" width="150" height="40" as="geometry"/></mxCell><mxCell id="contentores-v31" value="&lt;b&gt;Sistema externo&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;labelBackgroundColor=none;align=center;arcSize=10;fontSize=11;fontColor=#ffffff;spacing=8;fillColor=#8C8496;strokeColor=#736782;fontSize=11;" vertex="1" parent="1"><mxGeometry x="535" y="1146" width="150" height="40" as="geometry"/></mxCell><mxCell id="contentores-v32" value="&lt;b&gt;Fronteira&lt;/b&gt;" style="rounded=1;fontSize=11;whiteSpace=wrap;html=1;dashed=1;arcSize=20;fillColor=none;strokeColor=#666666;fontColor=#333333;labelBackgroundColor=none;align=left;spacing=10;dashPattern=8 4;connectable=0;allowArrows=0;pointerEvents=0;absoluteArcSize=1;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="700" y="1146" width="150" height="40" as="geometry"/></mxCell><mxCell id="contentores-v33" value="" style="text;html=1;" vertex="1" parent="1"><mxGeometry x="865" y="1156" width="1" height="20" as="geometry"/></mxCell><mxCell id="contentores-v34" value="" style="text;html=1;" vertex="1" parent="1"><mxGeometry x="985" y="1156" width="1" height="20" as="geometry"/></mxCell><mxCell id="contentores-e35" value="&lt;b&gt;Relação&lt;/b&gt;" style="endArrow=blockThin;html=1;fontSize=10;fontColor=#404040;strokeWidth=1;endFill=1;strokeColor=#828282;endSize=14;startSize=14;jumpStyle=arc;jumpSize=16;rounded=0;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="contentores-v33" target="contentores-v34"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="contentores-v36" value="A seta aponta para quem recebe o pedido. «Por decidir», «proposto» e «por definir» marcam o que a equipa ainda não fechou." style="text;html=1;align=left;verticalAlign=top;fontSize=12;fontColor=#5A626E;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="1005" y="1146" width="380" height="44" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="componentes" name="3. Componentes do backend"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="2400" pageHeight="1400" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="componentes-v1" value="Homaly: componentes do backend (C4, nível 3)" style="text;html=1;align=left;verticalAlign=top;fontSize=20;fontStyle=1;fontColor=#1B1F24;" vertex="1" parent="1"><mxGeometry x="20" y="-60" width="1400" height="34" as="geometry"/></mxCell><mxCell id="componentes-v2" value="Base: DECISIONS.md, USER_STORIES.md, docs/frontend-design.md, docs/mcp-dispositivos.md e os diagramas de sequência desta pasta. Versão de 2026-11-17. A divisão em componentes é lógica e segue as frentes de trabalho do PLANO.md; ainda não existe em código." style="text;html=1;align=left;verticalAlign=top;fontSize=12;fontColor=#5A626E;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="20" y="-24" width="1400" height="40" as="geometry"/></mxCell><mxCell id="componentes-v3" value="&lt;b&gt;&lt;font style=&quot;font-size: 14px&quot;&gt;PWA Homaly&lt;/font&gt;&lt;/b&gt;&lt;div&gt;[Contentor: React 19, Vite, TypeScript]&lt;/div&gt;&lt;br&gt;&lt;div&gt;&lt;font color=&quot;#EAF6FC&quot;&gt;Aplicação do responsável no telemóvel.&lt;/font&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;labelBackgroundColor=none;align=center;arcSize=10;fontSize=11;fontColor=#ffffff;spacing=8;fillColor=#23A2D9;strokeColor=#0E7DAD;" vertex="1" parent="1"><mxGeometry x="760" y="40" width="260" height="150" as="geometry"/></mxCell><mxCell id="componentes-v4" value="&lt;b&gt;&lt;font style=&quot;font-size: 14px&quot;&gt;Página do alerta&lt;/font&gt;&lt;/b&gt;&lt;div&gt;[Contentor: página web, por definir]&lt;/div&gt;&lt;br&gt;&lt;div&gt;&lt;font color=&quot;#EAF6FC&quot;&gt;Página só de leitura para o contacto externo.&lt;/font&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;labelBackgroundColor=none;align=center;arcSize=10;fontSize=11;fontColor=#ffffff;spacing=8;fillColor=#23A2D9;strokeColor=#0E7DAD;" vertex="1" parent="1"><mxGeometry x="1280" y="40" width="260" height="150" as="geometry"/></mxCell><mxCell id="componentes-v5" value="&lt;b&gt;&lt;font style=&quot;font-size: 14px&quot;&gt;Backend Homaly&lt;/font&gt;&lt;/b&gt;&lt;div&gt;[Contentor: Python 3.12, FastAPI, uvicorn]&lt;/div&gt;" style="rounded=1;fontSize=11;whiteSpace=wrap;html=1;dashed=1;arcSize=20;fillColor=none;strokeColor=#666666;fontColor=#333333;labelBackgroundColor=none;align=left;spacing=10;dashPattern=8 4;connectable=0;allowArrows=0;pointerEvents=0;absoluteArcSize=1;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="420" y="260" width="1460" height="560" as="geometry"/></mxCell><mxCell id="componentes-v6" value="&lt;b&gt;&lt;font style=&quot;font-size: 13px&quot;&gt;API REST e WebSocket&lt;/font&gt;&lt;/b&gt;&lt;div&gt;[Componente: FastAPI]&lt;/div&gt;&lt;br&gt;&lt;div&gt;&lt;font color=&quot;#FFFFFF&quot;&gt;Pedidos do contrato (/anomalias, /eventos, /conversa, /definicoes), o WebSocket /ws e o pedido da página do alerta.&lt;/font&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;labelBackgroundColor=none;align=center;arcSize=10;fontSize=11;fontColor=#ffffff;spacing=8;fillColor=#63BEF2;strokeColor=#2086C9;" vertex="1" parent="1"><mxGeometry x="1030" y="320" width="240" height="150" as="geometry"/></mxCell><mxCell id="componentes-v7" value="&lt;b&gt;&lt;font style=&quot;font-size: 13px&quot;&gt;Avisos (espera e SMS)&lt;/font&gt;&lt;/b&gt;&lt;div&gt;[Componente: Python]&lt;/div&gt;&lt;br&gt;&lt;div&gt;&lt;font color=&quot;#FFFFFF&quot;&gt;Publica as anomalias na aplicação, gere o tempo de espera do contacto externo e pede as SMS, incluindo a de resolvido.&lt;/font&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;labelBackgroundColor=none;align=center;arcSize=10;fontSize=11;fontColor=#ffffff;spacing=8;fillColor=#63BEF2;strokeColor=#2086C9;" vertex="1" parent="1"><mxGeometry x="1600" y="320" width="240" height="150" as="geometry"/></mxCell><mxCell id="componentes-v8" value="&lt;b&gt;&lt;font style=&quot;font-size: 13px&quot;&gt;Dispositivos (cliente MCP)&lt;/font&gt;&lt;/b&gt;&lt;div&gt;[Componente: Python, cliente MCP]&lt;/div&gt;&lt;br&gt;&lt;div&gt;&lt;font color=&quot;#FFFFFF&quot;&gt;Obtém o token, lê os sensores por polling, compara com a leitura anterior, guarda eventos, executa ações e capta imagens.&lt;/font&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;labelBackgroundColor=none;align=center;arcSize=10;fontSize=11;fontColor=#ffffff;spacing=8;fillColor=#63BEF2;strokeColor=#2086C9;" vertex="1" parent="1"><mxGeometry x="460" y="620" width="240" height="150" as="geometry"/></mxCell><mxCell id="componentes-v9" value="&lt;b&gt;&lt;font style=&quot;font-size: 13px&quot;&gt;Motor de anomalias&lt;/font&gt;&lt;/b&gt;&lt;div&gt;[Componente: Python, regras]&lt;/div&gt;&lt;br&gt;&lt;div&gt;&lt;font color=&quot;#FFFFFF&quot;&gt;Regras das sete anomalias do MVP. Compara com o habitual, as rotinas e os silêncios; resolve as que acabam sozinhas.&lt;/font&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;labelBackgroundColor=none;align=center;arcSize=10;fontSize=11;fontColor=#ffffff;spacing=8;fillColor=#63BEF2;strokeColor=#2086C9;" vertex="1" parent="1"><mxGeometry x="840" y="620" width="240" height="150" as="geometry"/></mxCell><mxCell id="componentes-v10" value="&lt;b&gt;&lt;font style=&quot;font-size: 13px&quot;&gt;Agente de IA&lt;/font&gt;&lt;/b&gt;&lt;div&gt;[Componente: Python, cliente do modelo]&lt;/div&gt;&lt;br&gt;&lt;div&gt;&lt;font color=&quot;#FFFFFF&quot;&gt;Avalia o contexto, decide se avisa, escreve a explicação, interpreta conversas e respostas e descreve imagens.&lt;/font&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;labelBackgroundColor=none;align=center;arcSize=10;fontSize=11;fontColor=#ffffff;spacing=8;fillColor=#63BEF2;strokeColor=#2086C9;" vertex="1" parent="1"><mxGeometry x="1220" y="620" width="240" height="150" as="geometry"/></mxCell><mxCell id="componentes-v11" value="&lt;b&gt;&lt;font style=&quot;font-size: 14px&quot;&gt;Base de dados&lt;/font&gt;&lt;/b&gt;&lt;div&gt;[Contentor: SQLite, proposto]&lt;/div&gt;&lt;br&gt;&lt;div&gt;&lt;font color=&quot;#EAF6FC&quot;&gt;Histórico, eventos, anomalias, conversa, rotinas, silêncios, veículos conhecidos e definições.&lt;/font&gt;&lt;/div&gt;" s