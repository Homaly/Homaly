# Valores partilhados pela equipa para o modo de desenvolvimento (npm run dev).
# Sao publicos: o Vite poe-nos no codigo que vai para o browser. Nunca pôr aqui credenciais.
# Para mudar so na tua maquina, cria frontend/.env.development.local (nao vai para o repo);
# um .env.local nao chega, porque este ficheiro tem prioridade sobre ele.

# true = dados falsos fixos, sem backend
VITE_USE_MOCKS=true

# Backend FastAPI (usado com VITE_USE_MOCKS=false). Vazios: a maquina de onde veio a pagina, na
# porta 8000 (localhost no portatil; o IP do portatil no telemovel na mesma rede). Ver src/api/enderecos.ts.
VITE_API_URL=
VITE_WS_URL=
