# Producao: so compila a PWA. scripts/deploy.sh copia o resultado da imagem para /srv/homaly/www,
# onde o Caddy do servidor o serve. Nao ha contentor do frontend a correr.
FROM node:24-slim AS build
WORKDIR /app

COPY package.json package-lock.json ./
RUN npm ci

COPY . .

# O Vite grava estes valores no codigo; tem de vir daqui, nao de um .env.
ARG VITE_API_URL
ARG VITE_WS_URL
ENV VITE_USE_MOCKS=false VITE_API_URL=$VITE_API_URL VITE_WS_URL=$VITE_WS_URL
RUN npm run build

FROM scratch
COPY --from=build /app/dist /
