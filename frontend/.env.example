# Os valores por omissao estao em frontend/.env.development, que vai para o repo.
# Para os mudar so na tua maquina, copia este ficheiro para frontend/.env.local (nao commitar).

# true = dados falsos fixos, sem backend
VITE_USE_MOCKS=false

# Backend FastAPI (usado com VITE_USE_MOCKS=false)
VITE_API_URL=http://localhost:8000
VITE_WS_URL=ws://localhost:8000/ws
