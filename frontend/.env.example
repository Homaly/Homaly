# Os valores por omissao estao em frontend/.env.development, que vai para o repo.
# Para os mudar so na tua maquina, copia este ficheiro para frontend/.env.development.local (nao commitar).
# Tem de ser esse nome: o Vite da ao .env.development prioridade sobre o .env.local.

# true = dados falsos fixos, sem backend
VITE_USE_MOCKS=false

# Backend FastAPI (usado com VITE_USE_MOCKS=false). Vazios: a maquina de onde veio a pagina, na
# porta 8000, o que serve no portatil e no telemovel na mesma rede. So com um tunel e preciso pô-los.
VITE_API_URL=
VITE_WS_URL=
